// Publishing the cookbook to GitHub Pages.
//
// Kept apart from cookbook.ffl because it composes another domain's facet
// (census.Publish.PublishWebBundle — the shared, token-gated Pages publisher),
// so compiling it needs that domain's FFL as a library:
//
//   fw ffl run --primary cookbook_site.ffl --library cookbook.ffl \
//       --library <fwh_census_us>/src/census_us/handlers/publish/ffl/census_publish.ffl \
//       --library <fwh_census_us>/src/census_us/handlers/downloads/ffl/census_operations.ffl \
//       --library facetwork/ffl/http.ffl --workflow cookbook.publish.PublishBook
//
// The bundle lands under "cookbook/". The publisher replaces only that subtree
// and merges the gallery landing, so other bundles are untouched. Pages render
// deterministically, so republishing an unchanged book commits nothing.

namespace cookbook.publish {
    use census.Publish

    /** Rebuild the book and publish it. */
    workflow PublishBook(repo: String = "rlemke/facetwork-maps", dest: String = "cookbook") => (
        pages_url: String,
        files: Int,
        commit: String,
        recipes: Int
    ) andThen {
        book = cookbook.workflows.Build()
        published = PublishWebBundle(
            repo = $.repo,
            prefixes = [book.output_dir],
            dests = [$.dest],
            include = [".html"],
            labels = ["The Low-Carb Kitchen (cookbook)"]
        )
        yield PublishBook(
            pages_url = published.pages_url,
            files = published.file_count,
            commit = published.commit,
            recipes = book.recipes
        )
    }
}
